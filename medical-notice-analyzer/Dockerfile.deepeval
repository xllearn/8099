# Controlled base refresh: docker.io/library/python:3.11-slim resolved 2026-07-27.
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/state \
    DEEPEVAL_TELEMETRY_OPT_OUT=1 \
    DEEPEVAL_DISABLE_DOTENV=1 \
    DEEPEVAL_NO_INSPECT_PROMPT=1 \
    ENABLE_DEEPEVAL_CACHE=0 \
    DEEPEVAL_ADVISORY_CONTRACT_REQUIRED=1

RUN groupadd --gid 10001 advisory \
    && useradd --uid 10001 --gid 10001 --no-create-home \
        --home-dir /state --shell /usr/sbin/nologin advisory \
    && install -d -m 0700 -o 10001 -g 10001 /state

COPY requirements-deepeval.lock /opt/advisory/requirements-deepeval.lock
RUN python -m pip install --no-cache-dir --require-hashes \
        --requirement /opt/advisory/requirements-deepeval.lock

WORKDIR /app

COPY app/__init__.py ./app/__init__.py
COPY app/evidence_schema.py ./app/evidence_schema.py
COPY app/evidence_index.py ./app/evidence_index.py
COPY app/formal_body.py ./app/formal_body.py
COPY app/diagnostics.py ./app/diagnostics.py
COPY app/schema_migrations.py ./app/schema_migrations.py
COPY app/report_rules ./app/report_rules
COPY app/deepeval_advisory ./app/deepeval_advisory
COPY scripts/run_deepeval_advisory.py ./scripts/run_deepeval_advisory.py
COPY tests/__init__.py ./tests/__init__.py
COPY tests/deepeval_advisory_image_contract.py ./tests/deepeval_advisory_image_contract.py
COPY tests/test_deepeval_advisory_judge.py ./tests/test_deepeval_advisory_judge.py
COPY tests/test_deepeval_advisory_evaluator.py ./tests/test_deepeval_advisory_evaluator.py

USER 10001:10001
CMD ["python", "-m", "unittest", "tests.deepeval_advisory_image_contract", "tests.test_deepeval_advisory_judge", "tests.test_deepeval_advisory_evaluator", "-v"]
